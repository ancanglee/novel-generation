{
  "$schema": "https://biomejs.dev/schemas/1.9.0/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "useSemanticElements": "off",
        "useKeyWithClickEvents": "off",
        "noLabelWithoutControl": "warn"
      },
      "correctness": {
        "noInvalidPositionAtImportRule": "off",
        "useExhaustiveDependencies": "warn"
      },
      "style": {
        "noNonNullAssertion": "warn"
      },
      "suspicious": {
        "noArrayIndexKey": "warn"
      }
    }
  },
  "files": {
    "ignore": [
      "node_modules",
      "**/node_modules",
      "dist",
      "**/dist",
      "build",
      "**/build",
      "cdk.out",
      ".venv",
      "aidlc-docs",
      "**/__pycache__",
      "pnpm-lock.yaml",
      "uv.lock"
    ]
  }
}
