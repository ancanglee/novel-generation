{
  "app": "python app.py",
  "watch": {
    "include": ["**"],
    "exclude": ["README.md", "cdk*.json", "**/__pycache__", "tests", "cdk.out"]
  },
  "context": {
    "@aws-cdk/core:stackRelativeExports": true,
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/aws-ecs:removeDefaultDeploymentAlarm": true,
    "@aws-cdk/aws-dynamodb:retainTableReplica": true,
    "availability-zones:account=111111111111:region=us-east-1": ["us-east-1a", "us-east-1b"],
    "availability-zones:account=111111111111:region=us-west-2": ["us-west-2a", "us-west-2b"]
  }
}
